// Exemplo principal da DSL TypeScript
// Este é o arquivo modelo que demonstra a capacidade do parser

class Animal {
    name: string;
    age: number;
    alive: boolean;
}

class Cat {
    energy: number;
    breath: number;
    sleeping: boolean;
}

class Dog {
    name: string;
    breed: string;
    trained: boolean;
}

class Person {
    firstName: string;
    lastName: string;
    age: number;
    active: boolean;
}
