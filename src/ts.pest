// Entrada principal
ts = { SOI ~ program ~ EOI }
program = { (klass)* }

// Declaração de classe
klass = { "class" ~ id ~ "{" ~ klass_body ~ "}" }

// Corpo da classe
klass_body = { (property)* }

// Declaração de propriedade
property = { id ~ ":" ~ metadata ~ ";" }

// Anotação de tipo
metadata = { primitive }

// Tipos primitivos
primitive = { "number" | "string" | "boolean" }

// Identificador
id = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }

// Comentários
COMMENT = _{ "//" ~ (!"\n" ~ ANY)* }

// Whitespace (espaços, tabs, newlines, comentários)
WHITESPACE = _{ " " | "\t" | "\n" | "\r" | COMMENT }
